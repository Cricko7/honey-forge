# Reference for the server-owned /etc/honey-forge/production.env.
# Merge with existing settings; never overwrite the real file during migration.
# Image references belong in the selected release's release.env, not here.
POSTGRES_VOLUME=honeyforge_postgres_data
KAFKA_VOLUME=honeyforge_kafka_data
REDIS_VOLUME=honeyforge_redis_data
POSTGRES_PASSWORD=REPLACE_WITH_EXISTING_POSTGRES_PASSWORD
REDIS_PASSWORD=REPLACE_WITH_EXISTING_REDIS_PASSWORD
CURSOR_KEY=REPLACE_WITH_EXISTING_32_BYTE_BASE64_KEY
PUBLIC_ORIGIN=https://honey-forge-seg-fault.ru
API_PUBLIC_ORIGIN=https://honey-forge-seg-fault.ru
PUBLIC_AGENT_WS_URL=wss://resources.honey-forge-seg-fault.ru/assets/stream
AGENT_WS_URL=wss://resources.honey-forge-seg-fault.ru/assets/stream
# Select the management bind address for the actual deployment.
# This safe default does not expose the management UI remotely.
MGMT_BIND_IP=127.0.0.1
DECOY_BIND_IP=0.0.0.0
MGMT_NETWORK=hf-mgmt
DECOY_NETWORK=hf-decoys
# Single-host mapping for synthetic TLS names; verify docker_gwbridge first.
# The server manifest must pass this variable to orchestrator.
AGENT_WS_HOST_IP=172.19.0.1
TRUSTED_PROXIES=
SUPPORT_SMTP_HOST=
SUPPORT_SMTP_PORT=
SUPPORT_SMTP_SECURITY=
SUPPORT_SMTP_USERNAME=
SUPPORT_SMTP_PASSWORD=
SUPPORT_SMTP_FROM=
