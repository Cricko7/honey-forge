            ],
            "properties": {
              "runtime_state": {
                "type": "string",
                "enum": [
                  "running",
                  "stopped"
                ]
              },
              "applied_profile_revision": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1,
                "maximum": 2147483647
              }
            }
          }
        }
      },
      "action": "stop",
      "params_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$ref": "#/$defs/EmptyObject",
        "$defs": {
          "EmptyObject": {
            "type": "object",
            "additionalProperties": false,
            "maxProperties": 0
          }
        }
      }
    },
    {
      "title": "apply_config",
      "result_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$ref": "#/$defs/RuntimeResult",
        "$defs": {
          "RuntimeResult": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "runtime_state",
              "applied_profile_revision"
            ],
            "properties": {
              "runtime_state": {
                "type": "string",
                "enum": [
                  "running",
