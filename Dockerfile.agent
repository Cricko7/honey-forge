# Сборка агента-воркера HoneyForge (edge-worker) в Docker.
# Один бинарник: обслуживает ловушку и сам порождает дочерний --worker процесс,
# который открывает TCP-порты приманки. Контекст сборки — корень репозитория.
FROM golang:1.26-alpine AS build
WORKDIR /src
COPY src/backend/go.mod src/backend/go.sum ./
RUN go mod download
COPY src/backend ./
RUN CGO_ENABLED=0 go build -trimpath -buildvcs=false -o /out/edge-worker ./cmd/agent

FROM alpine:3.20
RUN apk add --no-cache ca-certificates
WORKDIR /app
COPY --from=build /out/edge-worker ./edge-worker
ENTRYPOINT ["./edge-worker"]
