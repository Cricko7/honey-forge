# HoneyForge — единый origin через Caddy.
# Отдаёт собранный SPA и проксирует API+WSS на стаб-бэкенд.
# Caddy проксирует WebSocket автоматически — спец-настройка upgrade не нужна.
# handle-блоки взаимоисключающие: /api/* не попадает под SPA-fallback try_files.
:80 {
	encode gzip

	# API и WSS /api/stream → стаб-бэкенд в сети Docker
	handle /api/* {
		reverse_proxy stub:8080
	}

	# SPA: статика + fallback на index.html для клиентского роутинга
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
