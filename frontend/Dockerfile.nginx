# HoneyForge frontend для реального стека: сборка SPA → раздача через nginx,
# который проксирует API/WSS на Go-бэкенд. Сертификаты монтируются томом.
# ------- stage 1: сборка Vite -------
FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json* ./
RUN npm install
COPY . .
# Единый origin: API зовётся по тому же https-адресу, что и страница.
ARG VITE_API_BASE=https://localhost:8443
RUN echo "VITE_API_BASE=$VITE_API_BASE" > .env.production
RUN npm run build

# ------- stage 2: nginx -------
FROM nginx:alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 443
