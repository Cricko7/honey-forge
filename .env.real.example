# Скопируйте в .env в корне репозитория и подставьте сгенерированные значения.
# Сгенерировать оба секрета (PowerShell):
#   [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
POSTGRES_PASSWORD=change-me-base64-32
# Redis: generate at least 32 hexadecimal characters; do not reuse PostgreSQL's password.
REDIS_PASSWORD=REPLACE_WITH_RANDOM_HEX_PASSWORD
# Local management is loopback-only. For remote operators use an IP on an
# isolated mgmt interface; never 0.0.0.0 or an address in the decoy subnet.
MGMT_BIND_IP=127.0.0.1
MGMT_NETWORK=hf-mgmt
DECOY_NETWORK=hf-decoys
DECOY_BIND_IP=0.0.0.0
# CURSOR_KEY — ровно 32 байта в Base64 (постоянный, сохраните между перезапусками)
CURSOR_KEY=change-me-base64-32

# Support SMTP: configure all values in the deployment's private environment.
# Never commit real account settings or passwords. Leave all six empty to disable SMTP.
# Recipient is fixed to romanjigg@gmail.com; the form email becomes Reply-To.
SUPPORT_SMTP_HOST=
SUPPORT_SMTP_PORT=
SUPPORT_SMTP_SECURITY=
SUPPORT_SMTP_USERNAME=
SUPPORT_SMTP_PASSWORD=
SUPPORT_SMTP_FROM=
